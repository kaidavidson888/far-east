# ─── Supabase → Project Settings → API Keys ──────────────────────────────────
# "Publishable and secret API keys" tab.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The Publishable key — starts with sb_publishable_. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─── Supabase → Connect → Transaction pooler ─────────────────────────────────
# Use the pooler (port 6543), not the direct connection on 5432: serverless
# functions open far too many connections for Postgres to handle directly.
# Replace [YOUR-PASSWORD] with the database password you set at project creation.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-1-REGION.pooler.supabase.com:6543/postgres

# ─── Optional ────────────────────────────────────────────────────────────────
# The Secret key — starts with sb_secret_. Only needed for `npm run demo`.
# It bypasses every access control in the project: never expose it to the
# browser, never set it in a deployed environment, never commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# ─── Optional: log signups/logins to a Google Sheet (lib/logAuthEvent.ts) ────
# Appends [ISO timestamp, email, event] to a sheet you own. Passwords are never
# logged. Create a Google Cloud service account, enable the Sheets API, and
# share the target sheet with the service-account address as an Editor.
# GOOGLE_SA_EMAIL=far-east-logger@your-project.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
# SIGNUP_SHEET_ID=1AbCdEf…            # from the sheet's URL
# SIGNUP_SHEET_RANGE=Sheet1!A:C       # optional, this is the default
